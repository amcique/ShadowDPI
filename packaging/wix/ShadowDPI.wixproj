<Project Sdk="WixToolset.Sdk/7.0.1">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <Platform>x64</Platform>
    <Version Condition="'$(Version)' == ''">0.5.0</Version>
    <SourceDir Condition="'$(SourceDir)' == ''">$(MSBuildProjectDirectory)\..\..</SourceDir>
    <DefineConstants>SourceDir=$(SourceDir);Version=$(Version)</DefineConstants>
    <OutputName>shadowdpi-$(Version)-x64</OutputName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.1" />
  </ItemGroup>
</Project>
