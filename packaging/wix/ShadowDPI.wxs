<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?ifndef SourceDir?>
  <?define SourceDir = "$(sys.SOURCEFILEDIR)..\..\.." ?>
  <?endif?>
  <?ifndef Version?>
  <?define Version = "0.5.0" ?>
  <?endif?>

  <Package Id="ShadowDPI"
           Name="ShadowDPI $(var.Version)"
           Manufacturer="ShadowDPI"
           Version="$(var.Version)"
           UpgradeCode="6F1C4E85-9A2B-4F7A-9C31-2B6D8E4A1F30"
           Compressed="yes">

    <SummaryInformation Description="Modern and lightweight DPI circumvention utility for Windows x64." />
    <Icon Id="AppIcon" SourceFile="$(var.SourceDir)\shadowdpi.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/amcique/ShadowDPI" />
    <Property Id="ARPHELPLINK" Value="https://github.com/amcique/ShadowDPI/issues" />
    <Property Id="ARPCOMMENTS" Value="Unprivileged tray GUI and optional auto-start service." />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of ShadowDPI is already installed." />

    <!-- Service settings. Registry searches keep custom values on upgrade. -->
    <Property Id="SERVICENAME" Value="ShadowDPI">
      <RegistrySearch Id="ServiceNameSearch" Root="HKLM" Key="SOFTWARE\ShadowDPI"
                      Name="ServiceName" Type="raw" />
    </Property>
    <Property Id="SERVICEARGS" Value="-9">
      <RegistrySearch Id="ServiceArgsSearch" Root="HKLM" Key="SOFTWARE\ShadowDPI"
                      Name="ServiceArgs" Type="raw" />
    </Property>
    <Property Id="SERVICESTARTMODE" Value="auto">
      <RegistrySearch Id="ServiceStartModeSearch" Root="HKLM" Key="SOFTWARE\ShadowDPI"
                      Name="ServiceStartMode" Type="raw" />
    </Property>
    <Property Id="STARTATSERVICE" Value="1">
      <RegistrySearch Id="StartAtServiceSearch" Root="HKLM" Key="SOFTWARE\ShadowDPI"
                      Name="StartAtService" Type="raw" />
    </Property>
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- The PowerShell installer used a fixed ARP key with Publisher "amcique". -->
    <Property Id="LEGACY_PUBLISHER">
      <RegistrySearch Id="LegacyPublisherSearch" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\ShadowDPI"
                      Name="Publisher" Type="raw" />
    </Property>
    <Launch Condition="NOT (LEGACY_PUBLISHER = &quot;amcique&quot;)"
            Message="An older ShadowDPI install was found. Run install.ps1 -Action uninstall -Force before installing this MSI." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ShadowDPI" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ShadowDPI" />
    </StandardDirectory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ShadowDpiServiceFiles" Guid="*">
        <File Id="ShadowDpiExe" Source="$(var.SourceDir)\shadowdpi.exe" KeyPath="yes" />
        <ServiceInstall Id="ShadowDpiService"
                        Name="[SERVICENAME]"
                        DisplayName="ShadowDPI"
                        Description="ShadowDPI DPI circumvention service"
                        Type="ownProcess"
                        Start="demand"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="[SERVICEARGS]"
                        Interactive="no"
                        Vital="yes" />
        <ServiceControl Id="ShadowDpiServiceControl"
                        Name="[SERVICENAME]"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <Component Id="GuiExecutable" Guid="*">
        <File Id="ShadowDpiGuiExe" Source="$(var.SourceDir)\shadowdpi-gui.exe" KeyPath="yes" />
      </Component>
      <Component Id="WinDivertDll" Guid="*">
        <File Id="WinDivertDllFile" Source="$(var.SourceDir)\WinDivert.dll" KeyPath="yes" />
      </Component>
      <Component Id="WinDivertDriver" Guid="*">
        <File Id="WinDivertSysFile" Source="$(var.SourceDir)\WinDivert64.sys" KeyPath="yes" />
      </Component>
      <Component Id="InstallScript" Guid="*">
        <File Id="InstallScriptFile" Source="$(var.SourceDir)\install.ps1" KeyPath="yes" />
      </Component>
      <Component Id="LicenseFile" Guid="*">
        <File Id="LicenseFileFile" Source="$(var.SourceDir)\LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="NoticeFile" Guid="*">
        <File Id="NoticeFileFile" Source="$(var.SourceDir)\NOTICE" KeyPath="yes" />
      </Component>
      <Component Id="ReadmeEnFile" Guid="*">
        <File Id="ReadmeEn" Source="$(var.SourceDir)\README.md" KeyPath="yes" />
      </Component>
      <Component Id="ReadmeRuFile" Guid="*">
        <File Id="ReadmeRu" Source="$(var.SourceDir)\README.ru.md" KeyPath="yes" />
      </Component>
      <Component Id="ReadmeTrFile" Guid="*">
        <File Id="ReadmeTr" Source="$(var.SourceDir)\README.tr.md" KeyPath="yes" />
      </Component>
      <Component Id="SecurityDoc" Guid="*">
        <File Id="SecurityDocFile" Source="$(var.SourceDir)\SECURITY.md" KeyPath="yes" />
      </Component>
      <Component Id="ReleaseFileList" Guid="*">
        <File Id="ReleaseFileListFile" Source="$(var.SourceDir)\release-files.txt" KeyPath="yes" />
      </Component>

      <Component Id="ServiceSettings" Guid="*">
        <RegistryKey Root="HKLM" Key="SOFTWARE\ShadowDPI">
          <RegistryValue Name="ServiceName" Type="string" Value="[SERVICENAME]" />
          <RegistryValue Name="ServiceArgs" Type="string" Value="[SERVICEARGS]" />
          <RegistryValue Name="ServiceStartMode" Type="string" Value="[SERVICESTARTMODE]" />
          <RegistryValue Name="StartAtService" Type="string" Value="[STARTATSERVICE]" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="DocsFiles" Directory="INSTALLFOLDER" Subdirectory="docs"
                    Source="$(var.SourceDir)\docs">
      <Files Include="**" />
    </ComponentGroup>
    <ComponentGroup Id="ToolsFiles" Directory="INSTALLFOLDER" Subdirectory="tools"
                    Source="$(var.SourceDir)\tools">
      <Files Include="**" />
    </ComponentGroup>
    <ComponentGroup Id="ResourcesFiles" Directory="INSTALLFOLDER" Subdirectory="resources"
                    Source="$(var.SourceDir)\resources">
      <Files Include="**" />
    </ComponentGroup>
    <ComponentGroup Id="ThirdPartyFiles" Directory="INSTALLFOLDER" Subdirectory="third_party"
                    Source="$(var.SourceDir)\third_party">
      <Files Include="**" />
    </ComponentGroup>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcuts" Guid="*">
        <Shortcut Id="ConsoleShortcut" Name="ShadowDPI"
                  Target="[INSTALLFOLDER]shadowdpi.exe" WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="TrayShortcut" Name="ShadowDPI tray"
                  Target="[INSTALLFOLDER]shadowdpi-gui.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\ShadowDPI\Shortcuts"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveAppProgramsFolder" Directory="ApplicationProgramsFolder"
                      On="uninstall" />
      </Component>
    </DirectoryRef>

    <CustomAction Id="ConfigureServiceRecovery"
                  Directory="SystemFolder"
                  ExeCommand="sc.exe failure &quot;[SERVICENAME]&quot; reset= 86400 actions= restart/5000/restart/15000/restart/60000"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ConfigureServiceStartMode"
                  Directory="SystemFolder"
                  ExeCommand="sc.exe config &quot;[SERVICENAME]&quot; start= [SERVICESTARTMODE]"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="StartServiceIfRequested"
                  Directory="SystemFolder"
                  ExeCommand="sc.exe start &quot;[SERVICENAME]&quot;"
                  Execute="deferred" Impersonate="no" Return="check" />
    <!-- Native ServiceControl and registry removal do not always fire for
         components with formatted names. These make uninstall deterministic. -->
    <CustomAction Id="StopServiceOnUninstall"
                  Directory="SystemFolder"
                  ExeCommand="sc.exe stop &quot;[SERVICENAME]&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="DeleteServiceOnUninstall"
                  Directory="SystemFolder"
                  ExeCommand="sc.exe delete &quot;[SERVICENAME]&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="RemoveSettingsRegistry"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /c reg.exe delete HKLM\SOFTWARE\ShadowDPI /f /reg:64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="ConfigureServiceRecovery" After="InstallServices"
              Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="ConfigureServiceStartMode" After="ConfigureServiceRecovery"
              Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="StartServiceIfRequested" After="ConfigureServiceStartMode"
              Condition="NOT REMOVE~=&quot;ALL&quot; AND STARTATSERVICE = &quot;1&quot; AND SERVICESTARTMODE &lt;&gt; &quot;disabled&quot;" />
      <Custom Action="StopServiceOnUninstall" Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="DeleteServiceOnUninstall" After="StopServiceOnUninstall"
              Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RemoveSettingsRegistry" After="DeleteServiceOnUninstall"
              Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="ShadowDPI" Level="1"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="DocsFiles" />
      <ComponentGroupRef Id="ToolsFiles" />
      <ComponentGroupRef Id="ResourcesFiles" />
      <ComponentGroupRef Id="ThirdPartyFiles" />
      <ComponentRef Id="ShadowDpiServiceFiles" />
      <ComponentRef Id="GuiExecutable" />
      <ComponentRef Id="WinDivertDll" />
      <ComponentRef Id="WinDivertDriver" />
      <ComponentRef Id="InstallScript" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="NoticeFile" />
      <ComponentRef Id="ReadmeEnFile" />
      <ComponentRef Id="ReadmeRuFile" />
      <ComponentRef Id="ReadmeTrFile" />
      <ComponentRef Id="SecurityDoc" />
      <ComponentRef Id="ReleaseFileList" />
      <ComponentRef Id="ServiceSettings" />
      <ComponentRef Id="StartMenuShortcuts" />
    </Feature>

    <UIRef Id="ShadowDPI_UI" />
  </Package>
</Wix>
