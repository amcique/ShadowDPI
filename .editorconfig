# Shared editor defaults for this repository.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# GitHub metadata and other YAML files use two-space indentation.
[*.{yml,yaml}]
indent_size = 2

# Markdown wraps by hand, so trailing spaces are not meaningful.
[*.md]
trim_trailing_whitespace = false

# Windows batch files must keep CRLF so cmd.exe parses labels and blocks.
[*.{cmd,bat}]
end_of_line = crlf
