1 24 "@SHADOWDPI_GUI_MANIFEST_RESOURCE@"
// @SHADOWDPI_ICON_HASH@ forces regeneration when the icon content changes.
1 ICON "@SHADOWDPI_GUI_ICON_RESOURCE@"

1 VERSIONINFO
 FILEVERSION @SHADOWDPI_VERSION_COMMA@
 PRODUCTVERSION @SHADOWDPI_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "amcique"
            VALUE "FileDescription", "ShadowDPI tray application"
            VALUE "FileVersion", "@SHADOWDPI_VERSION_DOTTED@"
            VALUE "ProductName", "ShadowDPI"
            VALUE "ProductVersion", "@SHADOWDPI_VERSION_DOTTED@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
